# Nanonets DocStrange — business card OCR (Add Contact scan).
# Docs: https://docstrange.nanonets.com/docs/examples
#
# Copy to .env and run:
#   flutter pub get
#   flutter run --dart-define-from-file=.env

NANONETS_API_KEY=

# Optional overrides (defaults use built-in business-card JSON schema):
# Field list:  NANONETS_JSON_OPTIONS=["name","company","designation","mobile","email"]
# JSON schema: NANONETS_JSON_OPTIONS={"type":"object","properties":{...}}
# Hierarchy:   NANONETS_JSON_OPTIONS=hierarchy_output
#
# Optional metadata on response (comma-separated):
# NANONETS_INCLUDE_METADATA=confidence_score

# Do NOT set NANONETS_CUSTOM_INSTRUCTIONS when using JSON mode — it breaks structured output.
